# Contoh env web kartu Animein (salin ke .env.local lalu isi).
# File .env.local terpisah dari .env bot dan tidak ikut ke git.
# Web memakai kode pairing (.pair), jadi TIDAK butuh URL/kredensial Animein.

# Database Turso yang SAMA dengan bot (agar koleksi kartu nyambung)
TURSO_URL=
TURSO_AUTH_TOKEN=

# Kunci acak panjang untuk menyegel cookie sesi (isi dengan string acak, min 16 karakter)
SESSION_SECRET=

# Umur sesi login (hari). Default: 7
SESSION_MAX_AGE_DAYS=7
