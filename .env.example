# Contoh env web kartu Animein (salin ke .env.local lalu isi).
# File .env.local terpisah dari .env bot dan tidak ikut ke git.
# Web memakai kode pairing (.pair), jadi TIDAK butuh URL/kredensial Animein.

# Database Turso yang SAMA dengan bot (agar koleksi kartu nyambung)
# KEAMANAN: buat token read-write terbatas hanya untuk tabel web
# (battle_rooms, battle_messages, battle_history, trade_offers, web_group_messages,
#  user_cards, user_stats, card_battle_stats, settings). Jangan pakai token admin
# bot bila memungkinkan. Rotasi berkala.
TURSO_URL=
TURSO_AUTH_TOKEN=

# Username yang diabaikan dari hitungan stok gacha global (akun tes/admin, koma).
STOCK_EXCLUDE_USERNAMES=yogaa

# Kunci acak panjang untuk menyegel cookie sesi (isi dengan string acak, min 16 karakter)
SESSION_SECRET=

# Umur sesi login (hari). Default: 7
SESSION_MAX_AGE_DAYS=7

# Tripay (https://tripay.co.id/developer): Merchant Code, API Key, dan Private
# Key dari dashboard Tripay (menu Developer / Merchant).
# Callback URL -> https://kartu.yogaa.web.id/api/shop/webhook
# Return URL   -> https://kartu.yogaa.web.id/shop
# IP Whitelist di dashboard Tripay = IP publik/egress VPS (IPv4, + IPv6 bila ada).
# Bila VPS memakai firewall, izinkan callback Tripay dari:
#   95.111.200.230 (IPv4)
#   2a04:3543:1000:2310:ac92:4cff:fe87:63f9 (IPv6)
TRIPAY_MODE=production
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
# Kode channel Tripay: QRIS (default). Cek channel aktif di dashboard.
TRIPAY_CHANNEL=QRIS
TRIPAY_CALLBACK_URL=https://kartu.yogaa.web.id/api/shop/webhook
TRIPAY_RETURN_URL=https://kartu.yogaa.web.id/shop

# Tampilkan fitur Shop ke publik. Biarkan false (default) sampai kredensial
# Tripay siap; set true untuk tes lokal / saat launch.
# Catatan: ganti nilai ini butuh restart dev / redeploy.
NEXT_PUBLIC_SHOP_ENABLED=false

# Cloudinary untuk upload gambar kartu pajangan custom (maks 5MB).
# CLOUDINARY_FOLDER dipakai untuk upload custom (default 'animein/custom').
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=animein/custom
